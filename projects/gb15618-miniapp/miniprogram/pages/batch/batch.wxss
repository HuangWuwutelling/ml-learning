.container { padding: 24rpx; }
.hint {
  background: #f0f8ff;
  border-left: 8rpx solid #1890ff;
  padding: 16rpx;
  font-size: 24rpx;
  color: #333;
  margin-bottom: 24rpx;
  border-radius: 4rpx;
}
.section { margin-bottom: 24rpx; }
.filename {
  font-size: 26rpx;
  color: #666;
  margin-top: 12rpx;
  word-break: break-all;
}
.result { margin-top: 32rpx; }
.summary {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.card {
  flex: 1;
  text-align: center;
  padding: 24rpx 8rpx;
  border-radius: 12rpx;
  margin: 0 8rpx;
}
.card .num {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
}
.card .label {
  display: block;
  font-size: 22rpx;
  margin-top: 4rpx;
}
.green { background: #d4edda; color: #155724; }
.yellow { background: #fff3cd; color: #856404; }
.red { background: #f8d7da; color: #721c24; }
.total {
  text-align: center;
  margin: 24rpx 0;
  font-size: 28rpx;
  font-weight: bold;
}
.errors {
  margin-top: 24rpx;
  padding: 16rpx;
  background: #f8d7da;
  border-radius: 8rpx;
  max-height: 400rpx;
  overflow-y: auto;
}
.errors-title {
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}
.error-row {
  font-size: 24rpx;
  margin-top: 8rpx;
  word-break: break-all;
}
.actions {
  margin-top: 24rpx;
}