<view class="container">
  <view class="hint">
    Excel 模板列名：sampleId, crop（水田/旱地/果园）, pH, Cd, Hg, As, Pb, Cr, Cu, Zn, Ni
  </view>

  <view class="section">
    <button bindtap="onChooseFile" type="primary">选择 Excel 文件</button>
    <view class="filename" wx:if="{{filename}}">已选：{{filename}}</view>
  </view>

  <view class="section">
    <button bindtap="onDownloadTemplate">下载模板</button>
  </view>

  <button bindtap="onUpload" type="warn" disabled="{{!fileID || loading}}" loading="{{loading}}">开始评价</button>

  <view class="result" wx:if="{{result}}">
    <view class="summary">
      <view class="card green">
        <text class="num">{{result.summary['优先保护类']}}</text>
        <text class="label">优先保护类</text>
      </view>
      <view class="card yellow">
        <text class="num">{{result.summary['安全利用类']}}</text>
        <text class="label">安全利用类</text>
      </view>
      <view class="card red">
        <text class="num">{{result.summary['严格管控类']}}</text>
        <text class="label">严格管控类</text>
      </view>
    </view>
    <view class="total">共评价 {{result.total}} 个点位</view>

    <view class="errors" wx:if="{{result.errors.length > 0}}">
      <text class="errors-title">错误 {{result.errors.length}} 行</text>
      <view wx:for="{{result.errors}}" wx:key="row" class="error-row">
        第 {{item.row}} 行：{{item.reason}}
      </view>
    </view>

    <view class="actions">
      <button bindtap="onExportCSV">导出 CSV</button>
    </view>
  </view>
</view>