.container { padding: 24rpx; }
.risk-card {
  padding: 48rpx 24rpx;
  border-radius: 16rpx;
  text-align: center;
  margin-bottom: 32rpx;
}
.risk-card.green { background: #d4edda; color: #155724; }
.risk-card.yellow { background: #fff3cd; color: #856404; }
.risk-card.red { background: #f8d7da; color: #721c24; }
.risk-label {
  display: block;
  font-size: 28rpx;
}
.risk-level {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  margin: 12rpx 0;
}
.risk-pi {
  display: block;
  font-size: 24rpx;
}
.details-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
  border-left: 8rpx solid #1890ff;
}
.detail-row {
  display: flex;
  align-items: center;
  padding: 16rpx 8rpx;
  border-bottom: 1rpx solid #eee;
}
.metal {
  font-weight: bold;
  width: 80rpx;
}
.value {
  flex: 2;
  color: #666;
  font-size: 26rpx;
}
.pi {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
}
.pi.over {
  color: #dc3545;
  font-weight: bold;
}
.actions {
  margin-top: 32rpx;
}
.actions button {
  margin-bottom: 16rpx;
}