.container {
  padding: 24rpx;
}
.section {
  margin-bottom: 32rpx;
}
.label {
  font-size: 30rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
}
.picker {
  padding: 16rpx;
  border: 1rpx solid #ccc;
  border-radius: 8rpx;
  background: #fff;
}
.metal-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.metal-row {
  display: flex;
  align-items: center;
}
.metal-name {
  width: 80rpx;
  font-weight: bold;
}
.metal-row input {
  flex: 1;
  border: 1rpx solid #ccc;
  padding: 8rpx;
  border-radius: 4rpx;
  background: #fff;
}