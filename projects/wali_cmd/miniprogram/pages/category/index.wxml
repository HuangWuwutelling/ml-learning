<view class="container">
  <view class="platform-tabs">
    <view
      class="tab {{platform === 'linux' ? 'active' : ''}}"
      data-platform="linux"
      bindtap="onPlatformChange"
    >Linux</view>
    <view
      class="tab {{platform === 'windows' ? 'active' : ''}}"
      data-platform="windows"
      bindtap="onPlatformChange"
    >Windows</view>
  </view>

  <view class="category-list">
    <view
      class="category-item"
      wx:for="{{categories}}"
      wx:key="name"
      data-category="{{item.name}}"
      bindtap="onCategoryTap"
    >
      <text class="cat-name">{{item.name}}</text>
      <text class="cat-count">{{item.count}} 条</text>
    </view>
  </view>
</view>