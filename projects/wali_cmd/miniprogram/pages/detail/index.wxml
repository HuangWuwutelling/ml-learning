<view class="container" wx:if="{{command}}">
  <view class="header">
    <text class="name">{{command.name}}</text>
    <text class="platform-tag">{{command.platform}}</text>
  </view>

  <view class="section">
    <view class="section-title">语法</view>
    <view class="syntax" bindtap="onCopySyntax">
      <text>{{command.syntax}}</text>
    </view>
    <view class="hint">点击复制</view>
  </view>

  <view class="section" wx:if="{{command.example.length > 0}}">
    <view class="section-title">示例</view>
    <view
      class="example"
      wx:for="{{command.example}}"
      wx:key="*this"
      data-example="{{item}}"
      bindtap="onCopyExample"
    >
      <text>{{item}}</text>
    </view>
  </view>

  <view class="section">
    <view class="section-title">说明</view>
    <view class="description">{{command.description}}</view>
  </view>

  <view class="section tags-section" wx:if="{{command.tags.length > 0}}">
    <view class="section-title">标签</view>
    <view class="tags">
      <text class="tag" wx:for="{{command.tags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="section" wx:if="{{command.category}}">
    <view class="section-title">类目</view>
    <view class="category">{{command.category}}</view>
  </view>
</view>

<view class="loading" wx:elif="{{loading}}">加载中...</view>
