.header {
  background: #fff;
  padding: 32rpx;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}
.name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}
.platform-tag {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #3cc51f;
  background: #e8f7e0;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
}
.section {
  background: #fff;
  padding: 24rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}
.section-title {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 12rpx;
}
.syntax {
  font-family: monospace;
  font-size: 28rpx;
  color: #333;
  background: #f5f5f5;
  padding: 16rpx;
  border-radius: 4rpx;
  word-break: break-all;
}
.example {
  font-family: monospace;
  font-size: 26rpx;
  color: #333;
  background: #f5f5f5;
  padding: 16rpx;
  border-radius: 4rpx;
  margin-bottom: 12rpx;
  word-break: break-all;
}
.description {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}
.tags {
  display: flex;
  flex-wrap: wrap;
}
.tag {
  font-size: 24rpx;
  color: #888;
  background: #f5f5f5;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}
.category {
  font-size: 28rpx;
  color: #333;
}
.hint {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 8rpx;
  text-align: right;
}
.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}
