.app-name {
  text-align: center;
  font-size: 40rpx;
  font-weight: bold;
  margin: 60rpx 0 16rpx;
}
.version {
  text-align: center;
  color: #888;
  font-size: 26rpx;
  margin-bottom: 60rpx;
}
.section {
  background: #fff;
  padding: 24rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}
.section-title {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 12rpx;
}
.section-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
}