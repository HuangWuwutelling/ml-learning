.cmd-card {
  background: #fff;
  border-radius: 8rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #f0f0f0;
}
.cmd-name {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.platform-tag {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #3cc51f;
  background: #e8f7e0;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
}
.cmd-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}
.cmd-tags {
  margin-top: 12rpx;
}
.tag {
  font-size: 22rpx;
  color: #888;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
}